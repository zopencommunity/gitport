@@ -277,7 +277,26 @@ int sane_execvp(const char *file, char * const argv[])
 char *git_shell_path(void)
 {
 #ifndef GIT_WINDOWS_NATIVE
+#ifdef __MVS__
+	/*
+	 * z/OS: SHELL_PATH is baked in at build time and may point at a
+	 * bash that only exists on the build machine (the release CI bakes
+	 * $(BASH_HOME)/bin/bash, an absolute path of its own workspace).
+	 * Resolve bash from PATH at runtime so shell aliases and hooks
+	 * work regardless of where zopen is installed; fall back to the
+	 * build-time path only if it actually exists, then to /bin/sh.
+	 */
+	{
+		char *path = locate_in_PATH("bash");
+		if (path)
+			return path;
+		if (!access(SHELL_PATH, X_OK))
+			return xstrdup(SHELL_PATH);
+		return xstrdup("/bin/sh");
+	}
+#else
 	return xstrdup(SHELL_PATH);
+#endif
 #else
 	char *p = locate_in_PATH("sh");
 	convert_slashes(p);

+#!/bin/sh
+# Wrapper to run z/OS tests with cleaner output
+
+for test in t0082-zos-encoding.sh t0084-rerere-zos.sh t9001-zos-encoding-pull.sh; do
+    if [ -x "$test" ]; then
+        echo "Running $test..."
+        ./"$test" "$@" 2>&1 | grep -v "FSUM7351"
+        echo ""
+    fi
+done

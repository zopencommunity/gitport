+#!/bin/sh
+#
+# Copyright (c) 2024 IBM
+#
+
+test_description='Test z/OS encoding handling for git pull vs git clone'
+
+. ./test-lib.sh
+
+# Check if running on z/OS
+if ! uname | grep -q "OS/390"; then
+	skip_all='skipping z/OS-specific encoding tests'
+	test_done
+fi
+
+# Test that git pull properly re-tags files when encoding changes in .gitattributes
+test_expect_success 'setup repository with ISO8859-1 encoding' '
+	cat >.gitattributes <<-\EOF &&
+	* zos-working-tree-encoding=iso8859-1
+	.gitattributes zos-working-tree-encoding=iso8859-1
+	EOF
+	echo "Test content line 1" >testfile.txt &&
+	chtag -tc ISO8859-1 testfile.txt &&
+	git add .gitattributes testfile.txt &&
+	git commit -m "Initial commit with ISO8859-1"
+'
+
+test_expect_success 'clone repository and verify ISO8859-1 tagging' '
+	git clone . ../test-clone &&
+	(
+		cd ../test-clone &&
+		ls -T testfile.txt | grep "t ISO8859-1" &&
+		test -r testfile.txt
+	)
+'
+
+test_expect_success 'change encoding to IBM-1047 in .gitattributes' '
+	cat >.gitattributes <<-\EOF &&
+	* zos-working-tree-encoding=ibm-1047
+	.gitattributes zos-working-tree-encoding=iso8859-1
+	EOF
+	echo "Modified content with IBM-1047" >testfile.txt &&
+	chtag -tc IBM-1047 testfile.txt &&
+	git add .gitattributes testfile.txt &&
+	git commit -m "Change to IBM-1047 encoding"
+'
+
+test_expect_success 'git pull updates file tags to IBM-1047' '
+	(
+		cd ../test-clone &&
+		git pull &&
+		ls -T testfile.txt | grep "t IBM-1047" &&
+		test -r testfile.txt
+	)
+'
+
+test_expect_success 'fresh clone also gets IBM-1047 tagging' '
+	git clone . ../test-clone2 &&
+	(
+		cd ../test-clone2 &&
+		ls -T testfile.txt | grep "t IBM-1047" &&
+		test -r testfile.txt
+	)
+'
+
+test_expect_success 'both pull and clone produce same file tags' '
+	TAG1=$(cd ../test-clone && ls -T testfile.txt | awk "{print \$1}") &&
+	TAG2=$(cd ../test-clone2 && ls -T testfile.txt | awk "{print \$1}") &&
+	test "$TAG1" = "$TAG2" &&
+	test "$TAG1" = "t"
+'
+
+test_expect_success 'test git diff with working-tree-encoding' '
+	echo "New line" >>testfile.txt &&
+	git diff testfile.txt >diff.out &&
+	grep "+New line" diff.out &&
+	! grep -E "[\x80-\xff]" diff.out
+'
+
+test_expect_success 'test git stash with working-tree-encoding' '
+	echo "Stash test line" >>testfile.txt &&
+	TAG_BEFORE=$(ls -T testfile.txt | awk "{print \$1}") &&
+	git stash push testfile.txt &&
+	TAG_AFTER=$(ls -T testfile.txt | awk "{print \$1}") &&
+	test "$TAG_BEFORE" = "$TAG_AFTER" &&
+	test "$TAG_AFTER" = "t" &&
+	git stash pop &&
+	grep "Stash test line" testfile.txt
+'
+
+test_expect_success 'test git apply --3way with working-tree-encoding' '
+	echo "Original content" >applytest.txt &&
+	chtag -tc IBM-1047 applytest.txt &&
+	git add applytest.txt &&
+	git commit -m "Add applytest" &&
+	echo "Modified content" >applytest.txt &&
+	git add applytest.txt &&
+	git commit -m "Modify applytest" &&
+	git format-patch -1 HEAD -o /tmp &&
+	git reset --hard HEAD~1 &&
+	echo "Different content" >applytest.txt &&
+	git add applytest.txt &&
+	git commit -m "Different modification" &&
+	git apply --3way /tmp/0001-Modify-applytest.patch &&
+	TAG=$(ls -T applytest.txt | awk "{print \$1}") &&
+	test "$TAG" = "t" &&
+	grep "<<<<<<< ours" applytest.txt &&
+	grep "Modified content" applytest.txt
+'
+
+test_done

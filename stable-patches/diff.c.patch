diff --git a/diff.c b/diff.c
index 2a9d0d8..faad14c 100644
--- a/diff.c
+++ b/diff.c
@@ -4578,20 +4578,49 @@ int diff_populate_filespec(struct repository *r,
 		fd = open(s->path, O_RDONLY);
 		if (fd < 0)
 			goto err_empty;
+
+#ifdef __MVS__
+		/* On z/OS, mmap() ignores __disableautocvt() and auto-converts tagged files.
+		 * For files with working-tree-encoding, use read() instead to get raw bytes.
+		 * See: MMAP_AUTOCONVERT_HYPOTHESIS.md for details.
+		 */
+		if (would_convert_to_git(r->index, s->path)) {
+			/* Only disable autoconversion, don't change file tag */
+			__disableautocvt(fd);
+			s->data = xmalloc(s->size);
+			if (read_in_full(fd, s->data, s->size) != s->size) {
+				free(s->data);
+				close(fd);
+				goto err_empty;
+			}
+			close(fd);
+			s->should_free = 1;
+			s->should_munmap = 0;
+		} else {
+			s->data = xmmap(NULL, s->size, PROT_READ, MAP_PRIVATE, fd, 0);
+			close(fd);
+			s->should_munmap = 1;
+		}
+#else
 		s->data = xmmap(NULL, s->size, PROT_READ, MAP_PRIVATE, fd, 0);
 		close(fd);
 		s->should_munmap = 1;
+#endif
 
 		/*
 		 * Convert from working tree format to canonical git format
 		 */
-		if (convert_to_git(r->index, s->path, s->data, s->size, &buf, conv_flags)) {
+		int conversion_result = convert_to_git(r->index, s->path, s->data, s->size, &buf, conv_flags);
+		if (conversion_result > 0) {
 			size_t size = 0;
 			munmap(s->data, s->size);
 			s->should_munmap = 0;
 			s->data = strbuf_detach(&buf, &size);
 			s->size = size;
 			s->should_free = 1;
+		} else if (conversion_result < 0) {
+			warning(_("failed to convert '%s' to git format, using original data"), s->path);
+			/* Keep original data in s->data for diff */
 		}
 	}
 	else {
@@ -5829,6 +5858,20 @@ static enum parse_opt_result diff_opt_output(struct parse_opt_ctx_t *ctx,
 	path = prefix_filename(ctx->prefix, arg);
 	options->file = xfopen(path, "w");
 	options->close_file = 1;
+#ifdef __MVS__
+	/* Tag the output file based on .gitattributes */
+	if (options->file) {
+		int fd = fileno(options->file);
+		if (fd >= 0) {
+			__setfdbinary(fd);
+			__disableautocvt(fd);
+			/* Tag after we've written the diff output */
+			/* We'll tag it based on the first file's path, or use arg as fallback */
+		//	tag_file_as_working_tree_encoding(the_repository->index, arg, fd, 1);
+			__chgfdccsid(fd, utf8_ccsid);
+		}
+	}
+#endif
 	if (options->use_color != GIT_COLOR_ALWAYS)
 		options->use_color = GIT_COLOR_NEVER;
 	free(path);

+	 * z/OS: read the working-tree file raw (auto-conversion disabled)
+	 * and normalize it to the canonical (git-internal) form with the
+	 * same conversion git add performs (convert_to_git). All rerere
+	 * cache images (preimage/thisimage/postimage) are then canonical,
+	 * like the blobs they will be compared against, and the replay
+	 * conversion can convert the merged result back to the working-
+	 * tree encoding - the mirror image of checkout. A plain text-mode
+	 * fopen() would only convert by the file tag and leave e.g.
+	 * ISO8859-1 or process-codepage bytes in the cache, which the
+	 * replay conversion would then reject as invalid UTF-8 even when
+	 * the resolution is representable.
+	 */
+	memset(&io, 0, sizeof(io));
+	io.io.getline = rerere_mem_getline;

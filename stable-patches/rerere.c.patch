diff --git a/rerere.c b/rerere.c
index 1c3745d..80ed86c 100644
--- a/rerere.c
+++ b/rerere.c
@@ -12,6 +12,7 @@
 #include "string-list.h"
 #include "read-cache-ll.h"
 #include "rerere.h"
+#include "convert.h"
 #include "xdiff-interface.h"
 #include "dir.h"
 #include "resolve-undo.h"
@@ -663,11 +664,71 @@ static int merge(struct index_state *istate, const struct rerere_id *id, const c
 			      rerere_path(&buf, id, "postimage"));
 
 	/* Update "path" with the resolution */
+#ifdef __MVS__
+	{
+		/*
+		 * z/OS: 'result' is in the canonical form of the rerere cache
+		 * files. Convert it to the working-tree encoding before writing
+		 * it out, so the file content matches the tag applied below.
+		 *
+		 * Note: only the encoding (and CRLF) conversion is performed
+		 * here, deliberately NOT the full convert_to_working_tree()
+		 * pipeline. The cache images hold already-smudged working-tree
+		 * text (handle_file() performs no clean conversion when
+		 * recording them), so applying smudge filters again during
+		 * replay would run them a second time.
+		 */
+		struct conv_attrs ca;
+		struct strbuf wtresult = STRBUF_INIT;
+		int cr;
+
+		convert_attrs(istate, &ca, path);
+		ca.drv = NULL;
+		ca.ident = 0;
+		cr = convert_to_working_tree_ca(&ca, path,
+						result.ptr, result.size,
+						&wtresult, NULL);
+		if (cr < 0) {
+			/*
+			 * Encoding error: the resolution cannot be
+			 * represented in the working-tree encoding. Do
+			 * not overwrite the working file with
+			 * unconverted bytes (that would corrupt it);
+			 * fail the replay instead so the conflict is
+			 * preserved for manual resolution.
+			 */
+			strbuf_release(&wtresult);
+			ret = 1;
+			goto out;
+		}
+		if (cr > 0) {
+			free(result.ptr);
+			result.ptr = strbuf_detach(&wtresult, &result.size);
+		} else {
+			strbuf_release(&wtresult);
+		}
+	}
+#endif
 	f = fopen(path, "w");
 	if (!f)
 		return error_errno(_("could not open '%s'"), path);
+
+#ifdef __MVS__
+	int fd = fileno(f);
+	if (fd >= 0) {
+		__setfdbinary(fd);
+		__disableautocvt(fd);
+	}
+#endif
+
 	if (fwrite(result.ptr, result.size, 1, f) != 1)
 		error_errno(_("could not write '%s'"), path);
+
+#ifdef __MVS__
+	if (fd >= 0)
+		tag_file_as_working_tree_encoding(istate, path, fd, 1);
+#endif
+
 	if (fclose(f))
 		return error_errno(_("writing '%s' failed"), path);
 
@@ -730,7 +791,26 @@ static void do_rerere_one_path(struct index_state *istate,
 	/* Has the user resolved it already? */
 	if (variant >= 0) {
 		if (!handle_file(istate, path, NULL, NULL)) {
+#ifdef __MVS__
+			/*
+			 * z/OS: the working-tree file is in the working-tree
+			 * encoding (e.g. IBM-1047), while the cache files must
+			 * hold the canonical form. A raw copy_file() would store
+			 * unconverted bytes in postimage, so record it through
+			 * handle_file() - the same text-mode normalization that
+			 * produces preimage/thisimage - keeping all cache files
+			 * consistent. If recording fails, leave the resolution
+			 * unrecorded (a later run can retry) rather than storing
+			 * an invalid postimage.
+			 */
+			if (handle_file(istate, path, NULL,
+					rerere_path(&buf, id, "postimage"))) {
+				warning(_("could not record resolution for '%s'"), path);
+				goto out;
+			}
+#else
 			copy_file(the_repository, rerere_path(&buf, id, "postimage"), path, 0666);
+#endif
 			id->collection->status[variant] |= RR_HAS_POSTIMAGE;
 			fprintf_ln(stderr, _("Recorded resolution for '%s'."), path);
 			free_rerere_id(rr_item);

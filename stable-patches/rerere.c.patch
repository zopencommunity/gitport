+	struct conv_attrs ca;
+	int fd;
+	int autocvtToASCII = 0;
+
+	/*
+	 * z/OS: read the working-tree file and normalize it to the
+	 * canonical (UTF-8) form so that all rerere cache images
+	 * (preimage/thisimage/postimage) hold canonical bytes, like
+	 * the blobs they are compared against, and the replay
+	 * conversion can convert the merged result back to the
+	 * working-tree encoding.
+	 *
+	 * The read follows the same tag-aware rules git add uses
+	 * (validate_codeset()): a file tagged IBM-1047 under an
+	 * ISO8859-1 attribute is auto-converted on read; everything
+	 * else is read raw (auto-conversion disabled).
+	 *
+	 * The normalization is encoding-only (reencode_string_len),
+	 * deliberately NOT the full convert_to_git() pipeline: clean
+	 * filters must not run over conflict-marked content, since a
+	 * required filter that rejects marker-laden text (e.g. a
+	 * JSON validator) would break rerere entirely. The matching
+	 * replay conversion also skips smudge filters (see merge()).
+	 */
+	memset(&io, 0, sizeof(io));
+	io.io.getline = rerere_mem_getline;
+	io.io.wrerror = 0;
+
+	validate_codeset(istate, path, &autocvtToASCII);
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return error_errno(_("could not open '%s'"), path);
+	if (!autocvtToASCII)
+		__disableautocvt(fd);
+	if (strbuf_read(&raw, fd, 0) < 0) {
+		close(fd);
+		return error_errno(_("could not read '%s'"), path);
+	}
+	close(fd);
+
+	convert_attrs(istate, &ca, path);
+	if (ca.working_tree_encoding &&
+	    !same_encoding(ca.working_tree_encoding, "UTF-8")

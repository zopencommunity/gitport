+/*
+ * Subclass of rerere_io that reads from an in-core buffer that is a
+ * strbuf
+ */
+struct rerere_io_mem {
+	struct rerere_io io;
+	struct strbuf input;
+	size_t consumed;	/* offset of the next unread byte; avoids the
+			   quadratic buffer shifts of removing each
+			   consumed line from the front of the strbuf */
+};
+
+/*
+ * ... and its getline() method implementation
+ */
+static int rerere_mem_getline(struct strbuf *sb, struct rerere_io *io_)
+{
+	struct rerere_io_mem *io = (struct rerere_io_mem *)io_;
+	char *ep;
+	size_t len;
+
+	strbuf_release(sb);
+	if (io->consumed >= io->input.len)
+		return -1;
+	ep = memchr(io->input.buf + io->consumed, '\n',
+		    io->input.len - io->consumed);
+	if (!ep)
+		ep = io->input.buf + io->input.len;
+	else if (*ep == '\n')
+		ep++;
+	len = ep - (io->input.buf + io->consumed);
+	strbuf_add(sb, io->input.buf + io->consumed, len);
+	io->consumed += len;
+	return 0;
+}

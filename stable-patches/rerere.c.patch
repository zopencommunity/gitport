  * if that recorded conflict resolves cleanly what we
  * got in the "cur".
  */
+#ifdef __MVS__
+/*
+ * z/OS: rerere's cache files (preimage/thisimage/postimage) hold the
+ * canonical (git-internal UTF-8) form. handle_file() produces
+ * canonical preimage/thisimage via text-mode I/O, but a plain
+ * copy_file() of the working-tree file would store raw EBCDIC bytes
+ * in postimage. Read the working-tree file raw (auto-conversion
+ * disabled) and run it through convert_to_git() so postimage matches
+ * the other cache files.
+ */
+static int copy_workfile_to_cache_as_git(struct index_state *istate,
+					 const char *dst, const char *path)
+{
+	struct strbuf wt = STRBUF_INIT, conv = STRBUF_INIT;
+	const char *out;
+	size_t outlen;
+	int fd, ret = 0, cr;
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return -1;
+	__disableautocvt(fd);
+	if (strbuf_read(&wt, fd, 0) < 0)
+		ret = -1;
+	close(fd);
+	if (ret)
+		goto out;
+
+	cr = convert_to_git(istate, path, wt.buf, wt.len, &conv, 0);
+	if (cr < 0) {
+		ret = -1;
+		goto out;
+	}
+	if (cr > 0) {
+		out = conv.buf;
+		outlen = conv.len;
+	} else {
+		/* no conversion needed: the raw bytes are already canonical */
+		out = wt.buf;
+		outlen = wt.len;
+	}
+
+	fd = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	if (fd < 0) {
+		ret = -1;
+		goto out;
+	}
+	__disableautocvt(fd);
+	if (write_in_full(fd, out, outlen) < 0)
+		ret = -1;
+	close(fd);
+
+out:
+	strbuf_release(&wt);
+	strbuf_release(&conv);
+	return ret;
+}
+#endif

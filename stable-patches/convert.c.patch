+void tag_file_with_conv_attrs(const struct conv_attrs *ca, struct index_state *istate, const char *path, int fd, int was_converted) {
+	struct stat st;
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode))
+		return;
+
+	if (was_converted < 0) {
+		__chgfdccsid(fd, utf8_ccsid);
+		__disableautocvt(fd);
+		return;
+	}
+
+	/*
+	 * Use pre-computed binary status from ca->attr_action to avoid race condition.
+	 * The attributes were already computed before parallel checkout, so we don't
+	 * need to call git_check_attr() here (which would access shared attribute cache).
+	 * CRLF_BINARY means the file has -text or binary attribute set.
+	 */
+	int is_binary_set = (ca->attr_action == CRLF_BINARY);
+
+	/* Same priority logic as tag_file_as_working_tree_encoding */
+	if (is_binary_set && ca->working_tree_encoding) {
+		/* Explicit binary attribute overrides wildcard encoding */
+		__setfdbinary(fd);
+	}
+	else if (ca->working_tree_encoding) {
+		/* Encoding set */
+		if (!same_encoding(ca->working_tree_encoding, default_encoding)) {
+			__chgfdcodeset(fd, ca->working_tree_encoding);
+		} else {
+			__chgfdccsid(fd, utf8_ccsid);
+		}
+	}
+	else if (ca->attr_action == CRLF_BINARY) {
+		/* Binary (no encoding) */
+		__setfdbinary(fd);
+	}
+	else {
+		/* Default */
+		__chgfdccsid(fd, utf8_ccsid);
+	}
+
+	__disableautocvt(fd);
+}
